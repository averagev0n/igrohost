{
  "name": "igrohost",
  "version": "0.2.0",
  "description": "Панель игровых серверов на своём ПК: Terraria, Valheim, Rust, CS2, Palworld, Project Zomboid, 7 Days to Die, Enshrouded",
  "author": "averagev0n",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "local.igrohost",
    "productName": "Игрохост",
    "executableName": "Igrohost",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "CHANGELOG.md",
      "package.json"
    ],
    "asarUnpack": [
      "lib/ps/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Игрохост",
      "artifactName": "Igrohost-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Igrohost-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "averagev0n",
        "repo": "igrohost",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/averagev0n/igrohost.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "homepage": "https://github.com/averagev0n/igrohost"
}
